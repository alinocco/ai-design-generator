# Скопируйте в .env и раскомментируйте один из вариантов. .env в git не коммитим.

# --- Локально: Ollama (по умолчанию) ---
# ollama pull qwen2.5:7b-instruct
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_NUM_CTX=8192

# --- API: любой OpenAI-совместимый endpoint ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1     # или https://api.deepseek.com
# LLM_MODEL=имя-модели                           # точное имя смотрите в каталоге провайдера
# LLM_API_KEY=sk-...
# LLM_JSON_MODE=schema                           # schema | object | none — если API ругается на
#                                                # response_format, попробуйте object (DeepSeek) или none

# LLM_TEMPERATURE=0.1
# LLM_TIMEOUT=180
